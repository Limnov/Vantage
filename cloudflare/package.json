{
  "name": "vantage-cloudflare",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "build:web": "VITE_PLATFORM=cloudflare npm run build --prefix ../web && node prerender.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:browser": "node test/browser.mjs",
    "deploy:public": "wrangler deploy --config wrangler.public.jsonc",
    "build:web:public": "VITE_PRODUCT_ENABLED=false npm run build:web"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "wrangler": "^4.101.0"
  }
}
