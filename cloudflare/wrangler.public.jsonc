{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vantage",
  "account_id": "28c508bf41168952d42f067113491f4e",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "vantage.limnov.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "main": "public-entry.mjs",
  "keep_vars": true
}
