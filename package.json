{
  "name": "vantage",
  "version": "3.0.0",
  "private": true,
  "license": "MIT",
  "description": "以 Agent 为唯一业务入口的市场情报工作台",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup": "npm --prefix server ci && npm --prefix web ci",
    "dev": "node scripts/dev.js",
    "desktop:setup": "npm --prefix desktop ci",
    "desktop:start": "npm --prefix desktop start",
    "desktop:pack": "npm --prefix desktop run pack",
    "desktop:dist": "npm --prefix desktop run dist",
    "build": "npm --prefix web run build",
    "test": "npm --prefix server test",
    "check": "npm test && npm run build && npm --prefix server run eval:agent",
    "test:ui": "npm run build && node server/scripts/smoke-agent-ui.js",
    "test:live": "node server/scripts/smoke-agent-live.js"
  }
}
