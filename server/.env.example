# ============================================================
# Vantage 后端配置（示例）
# 复制为 .env 后填入真实值
# ============================================================

# 服务
PORT=3004
HOST=0.0.0.0
NODE_ENV=development
# 自助注册默认关闭；只有明确要允许公网注册时才改为 open。
REGISTRATION_MODE=disabled
# 直连时保持 false；由一层可信反向代理转发时设为 1。
TRUST_PROXY=false
# 公网部署必须填写实际前端源，多个值用逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5177,http://localhost:5177

# 数据库（SQLite；相对启动目录，默认自动使用 server/data/vantage.sqlite）
DB_PATH=./data/vantage.sqlite

# 首次迁移创建的系统管理员。密码必须显式设置，至少 12 位且不能使用常见默认值。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vantage.local
ADMIN_PASSWORD=replace-with-a-strong-password
# 仅供回环地址上的本机演示；开启时必须同时使用 development、127.0.0.1、admin/admin123。
# ALLOW_INSECURE_DEV_ADMIN=false

# 外部服务
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 通用自定义 AI Provider（OpenAI-compatible，可选）
# 配置 AI_API_KEY 后，该 Provider 优先于下方内置 Provider。
# 可在系统设置页修改，保存到被 Git 忽略的 server/.env；不写入数据库，支持热重载。
# ============================================================
# AI_PROVIDER_NAME=My LLM
# AI_API_KEY=sk-your-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT=60000

# ============================================================
# 内置 AI Provider - 阿里云百炼（内置 Provider 中优先级最高）
# 黑客松指定算力平台，多模型协同；若配置通用 AI_*，通用 Provider 优先
# ============================================================
BAILIAN_API_KEY=sk-your-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TIMEOUT=60000

# 百炼多模型配置（默认值已内置，可按需覆盖）
# BAILIAN_MODEL_TEXT=qwen/qwen3.7-max         # 旗舰推理：情报摘要
# BAILIAN_MODEL_FAST=qwen/qwen3.6-plus        # 全能模型：高频实时
# BAILIAN_MODEL_REASON=deepseek-r1            # 深度推理：定价策略
# BAILIAN_MODEL_LONG=kimi-k2.6                # 超长上下文：评论挖掘
# BAILIAN_MODEL_VISION=qwen/qwen3-vl-plus     # 视觉理解：竞品图解析
# BAILIAN_MODEL_EMBED=qwen/text-embedding-v4  # 向量化：语义检索
# BAILIAN_MODEL_RERANK=qwen/qwen3-rerank      # 精排：搜索匹配
# BAILIAN_MODEL_TTS=qwen/qwen3-tts-instruct-flash  # 语音：告警播报

# ============================================================
# 兜底 AI Provider（百炼不可用时自动降级）
# ============================================================

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# 思考模式：disabled（非思考） / enabled（思考）
DEEPSEEK_THINKING=disabled

# MiniMax
MINIMAX_API_KEY=your_key_here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat

# 飞书
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
# 可选：全局 Webhook 的签名密钥
FEISHU_SECRET=
FEISHU_DEFAULT_CHAT=oc_your_chat_id

# 调度
SCHEDULER_ENABLED=true
DAILY_REPORT_CRON=0 7 * * *
MASTER_SCHEDULE_CRON=* * * * *

# 日志
LOG_LEVEL=info
LOG_FORMAT=text

# 限流
RATE_LIMIT_MAX=120

# JWT
JWT_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
