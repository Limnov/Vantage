{
	admin 127.0.0.1:2019
}

vantage.limnov.com {
	tls /etc/vantage/tls/origin.pem /etc/vantage/tls/origin.key
	encode zstd gzip
	root * /opt/vantage/current/web/dist

	# Only Cloudflare and local health probes may reach the origin.
	@untrusted not remote_ip 127.0.0.1 ::1 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	route {
		respond @untrusted "Origin access requires Cloudflare" 403
		@backend path /api /api/* /mcp /mcp/* /health
		handle @backend {
			header Cache-Control "no-store"
			reverse_proxy 127.0.0.1:3004 {
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
				flush_interval -1
			}
		}
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle / {
			header Cache-Control "no-cache"
			try_files /index.html
			file_server
		}
		handle {
			header Cache-Control "no-cache"
			try_files {path} /app.html
			file_server
		}
	}
}
