{
  "folders": [
    {
      "name": "Vantage",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.git": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/package-lock.json": true
    },
    "git.defaultBranchName": "main",
    "editor.formatOnSave": true
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Vantage API (debug)",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/server",
        "program": "${workspaceFolder}/server/src/index.js",
        "envFile": "${workspaceFolder}/server/.env",
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Vantage: 安装依赖",
        "type": "shell",
        "command": "npm run setup",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Vantage: 启动 Electron Desktop",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Vantage: 浏览器辅助开发",
        "type": "shell",
        "command": "npm run dev:web",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Vantage: 检查",
        "type": "shell",
        "command": "npm run check",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Vantage: 构建桌面应用",
        "type": "shell",
        "command": "npm run desktop:pack",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      },
      {
        "label": "Vantage: 构建网站",
        "type": "shell",
        "command": "npm run build:site",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "presentation": {
          "reveal": "always",
          "panel": "new"
        }
      }
    ]
  }
}
