# ============================================================
# Vantage - Git 忽略规则
# ============================================================

# ─── Node.js ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── 构建产物 ──────────────────────────────────────────────
web/dist/
server/dist/
build/
*.tsbuildinfo

# ─── 环境变量 & 密钥（绝对不能提交）────────────────────
.env
.env.local
.env.*.local
server/.env
server/.env.mysql
web/.env

# ─── 备份文件 ──────────────────────────────────────────────
*.bak
*.backup
*.bak.*
.*-backup/
.backup-*/

# ─── 调试 / 一次性脚本 ────────────────────────────────────
test-*.js
scratch-*.js
/tmp/

# ─── 日志 ──────────────────────────────────────────────────
logs/
*.log
server/logs/
pm2-*.log

# ─── 运行时数据 ────────────────────────────────────────────
uploads/
tmp/
*.pid
*.seed
*.pid.lock

# ─── IDE / 编辑器 ──────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── 数据库本地数据（保留 schema，忽略 dump）──────────────
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.db
*.dump
*.sql.gz
db_data/
!db/migrations/*.sql
!db/seeds/*.sql

# ─── 测试覆盖率 ────────────────────────────────────────────
coverage/
.nyc_output/

# ─── OS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── 工具特定 ──────────────────────────────────────────────
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/

doc/

# Cloudflare deployment state and local secrets
cloudflare/dist/
.wrangler/
.dev.vars
.env.cloudflare.local
